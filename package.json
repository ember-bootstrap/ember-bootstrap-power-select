{
  "name": "ember-bootstrap-power-select",
  "version": "7.0.0",
  "description": "Integrate ember-power-select into your ember-bootstrap forms",
  "keywords": [
    "ember-addon",
    "ember-bootstrap",
    "ember-power-select"
  ],
  "repository": "https://github.com/ember-bootstrap/ember-bootstrap-power-select.git",
  "license": "MIT",
  "author": "Simon Ihmig <ihmig@kaliber5.de>",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember server",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "chalk": "^6.0.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-build-config-editor": "^0.5.0",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-template-imports": "^4.4.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@ember/optional-features": "3.0.0",
    "@ember/test-helpers": "5.5.2",
    "@embroider/macros": "1.21.1",
    "@embroider/test-setup": "4.0.0",
    "@eslint/js": "9.39.5",
    "@glimmer/component": "2.1.1",
    "@glimmer/tracking": "1.1.2",
    "bootstrap": "5.3.8",
    "broccoli-asset-rev": "3.0.0",
    "concurrently": "10.0.5",
    "ember-auto-import": "2.13.1",
    "ember-basic-dropdown": "9.0.0",
    "ember-bootstrap": "6.7.0",
    "ember-cli": "7.3.0",
    "ember-cli-clean-css": "3.0.0",
    "ember-cli-dependency-checker": "3.4.0",
    "ember-cli-deprecation-workflow": "4.0.1",
    "ember-cli-inject-live-reload": "2.1.0",
    "ember-cli-sri": "2.1.1",
    "ember-cli-terser": "4.0.2",
    "ember-concurrency": "5.3.0",
    "ember-load-initializers": "3.0.1",
    "ember-page-title": "9.0.3",
    "ember-power-select": "9.0.2",
    "ember-qunit": "9.2.0",
    "ember-resolver": "13.2.0",
    "ember-source": "6.12.0",
    "ember-source-channel-url": "3.0.0",
    "ember-template-lint": "7.9.3",
    "ember-try": "4.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ember": "13.6.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-qunit": "8.2.6",
    "globals": "17.13.0",
    "loader.js": "4.7.0",
    "prettier": "3.9.9",
    "prettier-plugin-ember-template-tag": "2.1.8",
    "qunit": "3.0.0",
    "qunit-dom": "3.6.0",
    "release-plan": "0.20.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "webpack": "5.111.1"
  },
  "peerDependencies": {
    "ember-bootstrap": ">=5",
    "ember-power-select": ">= 8.11",
    "ember-source": ">= 4.12"
  },
  "engines": {
    "node": "22.* || 24.* || >= 26"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config"
  }
}
